<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PhotoLibrary.App.ViewModels"
             xmlns:views="using:PhotoLibrary.App.Views"
             x:Class="PhotoLibrary.App.Views.AlbumsView"
             x:DataType="vm:AlbumsViewModel">
    <Grid ColumnDefinitions="280,4,*">

        <!-- Album list -->
        <DockPanel Grid.Column="0" Background="{DynamicResource KsSidebarBrush}">
            <DockPanel DockPanel.Dock="Top" Margin="12,10,8,6">
                <Button DockPanel.Dock="Right" Content="New album…" Click="NewAlbumClick" IsEnabled="{Binding !IsBusy}" />
                <TextBlock Text="Albums" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="{Binding EmptyText}" IsVisible="{Binding !HasAlbums}" TextWrapping="Wrap" Opacity="0.7" FontSize="12" Margin="12,4,12,8" />
            <ListBox ItemsSource="{Binding Albums}" SelectedItem="{Binding SelectedAlbum, Mode=TwoWay}" Margin="4,0,0,4" Background="Transparent">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:AlbumViewModel">
                        <Grid ColumnDefinitions="Auto,Auto,*" Margin="2,3" ToolTip.Tip="{Binding Description}">
                            <Border Grid.Column="0" Width="4" CornerRadius="2" Background="{Binding ColourBrush}" Margin="0,2,8,2" />
                            <Border Grid.Column="1" Width="44" Height="44" CornerRadius="5" ClipToBounds="True" Background="{DynamicResource KsTileBrush}" Margin="0,0,10,0">
                                <Panel>
                                    <Image Source="{Binding Cover}" Stretch="UniformToFill" />
                                    <views:LockIcon Width="18" Height="18" Opacity="0.6" IsVisible="{Binding IsSecure}" />
                                </Panel>
                            </Border>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="1">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="{Binding CountText}" FontSize="12" Opacity="0.7" />
                                    <Border Background="{DynamicResource KsChipBrush}" CornerRadius="3" Padding="5,0" IsVisible="{Binding IsPhysical}">
                                        <TextBlock Text="folder" FontSize="11" Opacity="0.8" />
                                    </Border>
                                    <Border Background="{DynamicResource KsChipBrush}" CornerRadius="3" Padding="5,0" IsVisible="{Binding IsSecure}">
                                        <TextBlock Text="secure" FontSize="11" Opacity="0.8" />
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <GridSplitter Grid.Column="1" />

        <!-- Selected album -->
        <DockPanel Grid.Column="2">
            <Border DockPanel.Dock="Top" Padding="12,10,12,8" IsVisible="{Binding HasSelectedAlbum}">
                <Grid ColumnDefinitions="Auto,*,Auto" DataContext="{Binding SelectedAlbum}" x:DataType="vm:AlbumViewModel">
                    <Border Grid.Column="0" Width="64" Height="64" CornerRadius="8" ClipToBounds="True" Background="{DynamicResource KsTileBrush}"
                            BorderThickness="3" BorderBrush="{Binding ColourBrush}" Margin="0,0,12,0">
                        <Panel>
                            <Image Source="{Binding Cover}" Stretch="UniformToFill" />
                            <views:LockIcon Width="26" Height="26" Opacity="0.6" IsVisible="{Binding IsSecure}" />
                        </Panel>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Description}" FontSize="12" Opacity="0.7" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Content="Show folder" Command="{Binding $parent[UserControl].((vm:AlbumsViewModel)DataContext).ShowFolderCommand}" IsVisible="{Binding IsPhysical}" />
                        <Button Content="Album settings…" Click="SettingsClick" />
                    </StackPanel>
                </Grid>
            </Border>
            <Border DockPanel.Dock="Top" Margin="12,0,12,8" IsVisible="{Binding ShowFilterBar}">
                <views:FilterBar DataContext="{Binding Filter}" />
            </Border>
            <ContentControl DockPanel.Dock="Top" Content="{Binding Vault}" IsVisible="{Binding SelectedIsSecure}" />
            <Panel IsVisible="{Binding !SelectedIsSecure}">
                <TextBlock Text="{Binding EmptyText}" IsVisible="{Binding EmptyText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.6" TextWrapping="Wrap" MaxWidth="420" TextAlignment="Center" />
                <ScrollViewer x:Name="GridScroll">
                    <ItemsControl ItemsSource="{Binding Groups}" Margin="8,0,8,12">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:DayGroupViewModel">
                                <StackPanel Margin="0,4,0,10">
                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="4,0,0,4">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding CountText}" Opacity="0.6" />
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding Photos}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:PhotoViewModel">
                                                <views:PhotoTile />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Panel>
        </DockPanel>
    </Grid>
</UserControl>
