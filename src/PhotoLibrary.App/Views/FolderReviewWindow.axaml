<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PhotoLibrary.App.ViewModels"
        x:Class="PhotoLibrary.App.Views.FolderReviewWindow"
        x:DataType="vm:FolderReviewViewModel"
        Title="Library folders" Width="720" Height="620" MinWidth="560" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,12">
            <TextBlock Text="{Binding Heading}" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Intro}" TextWrapping="Wrap" Opacity="0.8" FontSize="13" />
            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding !IsEmpty}">
                <Button Content="All date folders" Click="AllDatesClick" />
                <Button Content="All albums" Click="AllAlbumsClick" />
            </StackPanel>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Spacing="10" Margin="0,12,0,0">
            <Border Classes="warn" IsVisible="{Binding SuggestedLayout, Converter={x:Static ObjectConverters.IsNotNull}}">
                <CheckBox IsChecked="{Binding UseSuggestedLayout}">
                    <TextBlock Text="{Binding SuggestedLayoutText}" TextWrapping="Wrap" FontSize="12" />
                </CheckBox>
            </Border>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Content="Decide later" IsCancel="True" Click="CancelClick" MinWidth="110" />
                <Button Classes="accent" Content="Save" Click="SaveClick" MinWidth="110" IsEnabled="{Binding !IsEmpty}" />
            </StackPanel>
        </StackPanel>

        <Panel>
            <TextBlock Text="There are no top-level folders to review." IsVisible="{Binding IsEmpty}" Opacity="0.6"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
            <ScrollViewer>
                <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:FolderRowViewModel">
                            <Border Classes="card" Margin="0,0,0,8" Padding="12,8">
                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Detail}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" SelectedIndex="{Binding Choice, Mode=TwoWay}" MinWidth="150" VerticalAlignment="Center" Margin="12,0,0,0">
                                        <ComboBoxItem Content="Date folder" />
                                        <ComboBoxItem Content="Folder album" />
                                        <ComboBoxItem Content="Delete empty folder" IsVisible="{Binding CanDelete}" />
                                    </ComboBox>
                                    <Border Grid.Row="1" Grid.ColumnSpan="2" Classes="warn" IsVisible="{Binding HasWarning}" Margin="0,8,0,0">
                                        <TextBlock Text="{Binding Warning}" TextWrapping="Wrap" FontSize="12" />
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Panel>
    </DockPanel>
</Window>
