<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PhotoLibrary.App.ViewModels"
        xmlns:views="using:PhotoLibrary.App.Views"
        x:Class="PhotoLibrary.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/keepsake.ico"
        Title="Keepsake" Width="1280" Height="800" MinWidth="900" MinHeight="500">
    <Window.KeyBindings>
        <KeyBinding Gesture="Delete" Command="{Binding RemoveSelectedCommand}" />
    </Window.KeyBindings>

    <DockPanel>
        <!-- App bar: brand, library, actions -->
        <Border DockPanel.Dock="Top" Classes="appbar">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Classes="subtle" Content="Rescan" Command="{Binding RescanCommand}" IsEnabled="{Binding !IsBusy}"
                            ToolTip.Tip="Look for new, changed and removed files" />
                    <Button Content="Organise…" Click="OrganiseClick" IsEnabled="{Binding !IsBusy}"
                            ToolTip.Tip="Preview, then file everything into dated folders" />
                    <Button Classes="accent" Content="Import folder…" Click="ImportClick" IsEnabled="{Binding !IsBusy}"
                            ToolTip.Tip="Copy what's missing from another folder into the library" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Border Width="30" Height="30" CornerRadius="7" ClipToBounds="True">
                        <Image Source="/Assets/keepsake-128.png" />
                    </Border>
                    <TextBlock Text="Keepsake" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Border Classes="chip" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{Binding LibraryRoot}" VerticalAlignment="Center" FontSize="12" MaxWidth="360" TextTrimming="PathSegmentEllipsis" ToolTip.Tip="{Binding LibraryRoot}" />
                            <Button Classes="subtle" Content="Change…" Click="ChangeLibraryClick" IsEnabled="{Binding !IsBusy}" Padding="6,1" FontSize="12" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding LibrarySummary}" Classes="muted" VerticalAlignment="Center" FontSize="12" />
                    <Button Background="{DynamicResource KsWarnBrush}" Padding="9,3" IsVisible="{Binding NeedsFfmpeg}" Command="{Binding OpenSettingsCommand}"
                            ToolTip.Tip="Video thumbnails and previews are made with ffmpeg. Settings has a one-click download.">
                        <TextBlock Text="Videos have no previews: set up ffmpeg…" FontSize="12" />
                    </Button>
                    <Button Background="{DynamicResource KsWarnBrush}" Padding="9,3" IsVisible="{Binding HasUndecidedFolders}" Click="ReviewFoldersClick">
                        <TextBlock Text="{Binding UndecidedFoldersText}" FontSize="12" />
                    </Button>
                    <Border Classes="warn" IsVisible="{Binding NeedsOrganise}" VerticalAlignment="Center">
                        <TextBlock Text="Some files aren't in dated folders yet: see Organise" FontSize="12" />
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Classes="statusbar">
            <DockPanel>
                <ProgressBar DockPanel.Dock="Right" Width="220" Height="6" CornerRadius="3" Minimum="0" Maximum="100"
                             Value="{Binding ProgressPercent}" IsIndeterminate="{Binding ProgressIndeterminate}"
                             IsVisible="{Binding IsBusy}" Margin="12,0,0,0" />
                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" FontSize="12" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

            <!-- Preview pane -->
            <Border DockPanel.Dock="Right" Width="420" IsVisible="{Binding PreviewVisible}" BorderThickness="1,0,0,0" Background="{DynamicResource KsSidebarBrush}" BorderBrush="{DynamicResource KsBorderBrush}" Padding="10">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Content="✕" Command="{Binding ClosePreviewCommand}" Padding="6,2" />
                        <TextBlock DockPanel.Dock="Right" Text="{Binding SelectionText}" Opacity="0.6" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding PreviewTitle}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,8,0,0">
                        <TextBlock Text="{Binding PreviewDetails}" TextWrapping="Wrap" FontSize="12" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Open" Command="{Binding OpenSelectedCommand}" />
                            <Button Content="Show in folder" Command="{Binding ShowSelectedInFolderCommand}" />
                        </StackPanel>
                    </StackPanel>
                    <Panel>
                        <Image Source="{Binding PreviewBitmap}" Stretch="Uniform" />
                        <TextBlock Text="No preview available for this file type" IsVisible="{Binding PreviewUnavailable}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.6" />
                    </Panel>
                </DockPanel>
            </Border>

        <!-- Main content with tabs -->
        <TabControl SelectedIndex="{Binding SelectedTab, Mode=TwoWay}" SelectionChanged="TabChanged">
            <!-- Library tab -->
            <TabItem Header="Library">
                <Grid ColumnDefinitions="240,4,*">
                    <!-- Date tree -->
                    <TreeView Grid.Column="0" ItemsSource="{Binding Nodes}" SelectedItem="{Binding SelectedNode, Mode=TwoWay}" Padding="4" Background="{DynamicResource KsSidebarBrush}">
                        <TreeView.ItemTemplate>
                            <TreeDataTemplate ItemsSource="{Binding Children}" x:DataType="vm:TreeNodeViewModel">
                                <TextBlock Text="{Binding Label}" />
                            </TreeDataTemplate>
                        </TreeView.ItemTemplate>
                        <TreeView.Styles>
                            <Style Selector="TreeViewItem" x:DataType="vm:TreeNodeViewModel">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                            </Style>
                        </TreeView.Styles>
                    </TreeView>

                    <GridSplitter Grid.Column="1" />

                    <!-- Thumbnail grid -->
                    <DockPanel Grid.Column="2">
                        <TextBlock DockPanel.Dock="Top" Text="{Binding HeaderText}" FontSize="18" FontWeight="SemiBold" Margin="12,10,12,4" />
                        <!-- Sort and filter bar -->
                        <views:FilterBar DockPanel.Dock="Top" Margin="12,0,12,8" DataContext="{Binding Filter}" />
                        <ScrollViewer x:Name="GridScroll">
                            <ItemsControl ItemsSource="{Binding Groups}" Margin="8,0,8,12">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:DayGroupViewModel">
                                        <StackPanel Margin="0,4,0,10">
                                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="4,0,0,4">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding CountText}" Opacity="0.6" />
                                            </StackPanel>
                                            <ItemsControl ItemsSource="{Binding Photos}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:PhotoViewModel">
                                                        <views:PhotoTile />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>

                </Grid>
            </TabItem>

            <!-- Albums tab -->
            <TabItem Header="Albums">
                <views:AlbumsView DataContext="{Binding Albums}" />
            </TabItem>

            <!-- AI Tools tab -->
            <TabItem Header="AI Tools">
                <views:AiPanelView DataContext="{Binding Ai}" />
            </TabItem>

            <!-- Duplicates tab -->
            <TabItem Header="Duplicates">
                <views:DuplicatesView DataContext="{Binding Duplicates}" />
            </TabItem>

            <!-- Quality tab -->
            <TabItem Header="Quality">
                <views:QualityView DataContext="{Binding Quality}" />
            </TabItem>

            <!-- Settings tab -->
            <TabItem Header="Settings">
                <views:SettingsView DataContext="{Binding Settings}" />
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
