<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PhotoLibrary.App.Views.NewPasswordWindow"
        Width="460" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="20" Spacing="12">
        <TextBlock x:Name="Heading" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock x:Name="Message" TextWrapping="Wrap" />
        <TextBox x:Name="PasswordBox" PasswordChar="●" PlaceholderText="New password" />
        <TextBox x:Name="ConfirmBox" PasswordChar="●" PlaceholderText="Type it again" />
        <TextBlock Text="At least 10 characters. A few unrelated words make a strong password that's easy to remember." FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
        <TextBlock x:Name="Error" Foreground="{DynamicResource KsErrorBrush}" FontSize="12" TextWrapping="Wrap" IsVisible="False" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="Cancel" IsCancel="True" Click="CancelClick" MinWidth="90" />
            <Button Classes="accent" Content="Set password" IsDefault="True" Click="OkClick" MinWidth="110" />
        </StackPanel>
    </StackPanel>
</Window>
